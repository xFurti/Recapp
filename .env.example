# Yesterday Pack (Ieri) - configuration
# Copy this file to `.env` and fill in the values you need.
# Every variable is optional in local development: the defaults run the whole
# app offline (SQLite, simulated OCR, tasks run in-process).
# NEVER commit `.env`. On Render, set the same variables under
# Service -> Environment.

# --- App ---------------------------------------------------------------------
# dev | prod. In prod the session secret is mandatory and cookies are Secure.
APP_ENV=dev
# Public address of the site, used for invite links / QR codes and Origin checks.
# Local: http://localhost:5173   Production: https://bassaleo.xyz
PUBLIC_URL=http://localhost:5173
# Long random string used to sign login cookies.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Database ----------------------------------------------------------------
# Local default: sqlite:///./ieri.db
# Neon: Dashboard -> your project -> Connection string (choose "psycopg"),
# e.g. postgresql+psycopg://user:password@ep-xxx.eu-central-1.aws.neon.tech/ieri?sslmode=require
DATABASE_URL=

# --- School area (owner = headteacher / staff) --------------------------------
# Created or updated at startup. Local defaults: preside / demo
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_DISPLAY_NAME=

# --- OCR / AI ----------------------------------------------------------------
# mock = offline rule-based parser (default) | featherless = real AI
OCR_PROVIDER=mock
# Featherless: https://featherless.ai -> Account -> API Keys
FEATHERLESS_API_KEY=
# Model id from the Featherless catalog. Vision model for screenshots,
# e.g. a Qwen2.5-VL instruct model. Text model used for pasted lines.
FEATHERLESS_MODEL=
FEATHERLESS_TEXT_MODEL=

# --- Task runner --------------------------------------------------------------
# inline = run OCR tasks inside the web service (default)
# render = run them on Render Workflows
TASK_RUNNER=inline
# Render: Account settings -> API Keys. Needed when TASK_RUNNER=render, and on
# Render for the "update in progress" notice (reads this service's deploy status).
RENDER_API_KEY=
# "<workflow-slug>/extract_items", shown in the Render dashboard of the workflow.
RENDER_WORKFLOW_TASK=
